SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase Postgres connection
# Find this in your Supabase project: Project Settings -> Database -> Connection string (URI)
# Use the "Transaction pooler" URI (port 6543) for serverless/many short-lived connections,
# or the direct connection (port 5432) for local dev / long-lived connections.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres

# Gemini API key for the AI librarian and AI Auntie (aistudio.google.com -> Get API key).
# Free tier: no billing required, rate-limited requests per minute/day.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq API key for the AI career counsellor (console.groq.com -> API Keys).
# Free tier: no billing required, rate-limited requests per minute/day.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Email verification delivery
# For real email sending, set SMTP values below. If left empty, Django will use
# the console backend so verification links are printed in the terminal instead.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@dera.local
FRONTEND_URL=http://localhost:5173
